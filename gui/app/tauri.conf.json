{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lichen",
  "version": "0.4.0",
  "identifier": "io.github.adamisz.lichen",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "lichen wallet", "width": 1000, "height": 820 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
